     "PK_TYPES": "VARCHAR2~VARCHAR2", "DEFAULT_ORDER_BY": "FACTOR_CODE"}
  ],

  "lovs": [
    {"LOV_NAME": "LOV_CUSTOMER",
     "LOV_QUERY": "SELECT CUSTOMER_NO, CUSTOMER_NAME1 FROM STTM_CUSTOMER WHERE RECORD_STAT = 'O' AND AUTH_STAT = 'A'",
     "columns": [
       {"QUERY_COLS": "CUSTOMER_NO", "COL_HEADING": "LBL_CUSTOMER_NO", "MIN_SEARCH_CHAR_LEN": "3"},
       {"QUERY_COLS": "CUSTOMER_NAME1", "COL_HEADING": "LBL_CUSTOMER_NAME"}
     ]}
  ],

  "blocks": [
    {"BLOCK_NAME": "BLK_RISK_MASTER", "MASTER_BLOCK": "Y", "BLK_PK_FLD": "CUSTNO",
     "BLOCK_TITLE": "LBL_RISK_PROFILE", "XSD_NODE": "Risk-Master",
     "datasources": ["STTMS_CUST_RISK_PROFILE"],
     "fields": [
       {"FIELD_NAME": "CUSTNO", "BLOCK_PK_FLD": "Y", "FIELD_SIZE": "20", "DATATYPE": "VARCHAR2", "MAX_LENGTH": "20",
        "REQUIRED": "Y", "DISPLAY_TYPE": "LOV", "LOV_NAME": "LOV_CUSTOMER", "DBT": "STTMS_CUST_RISK_PROFILE",
        "DBC": "CUSTOMER_NO", "CHK_UPPERCASE": "Y", "FLD_ANNOTATION": "Customer No",
        "return_fields": [
          {"QUERY_COLUMN": "CUSTOMER_NO", "RETURN_BLK_NAME": "BLK_RISK_MASTER", "RETURN_FLD_NAME": "CUSTNO"},
          {"QUERY_COLUMN": "CUSTOMER_NAME1", "RETURN_BLK_NAME": "BLK_RISK_MASTER", "RETURN_FLD_NAME": "CUSTNAME"}
        ]},
       {"FIELD_NAME": "CUSTNAME", "FIELD_SIZE": "35", "DATATYPE": "VARCHAR2", "MAX_LENGTH": "105",
        "PARENT_FIELD": "CUSTNO", "READ_ONLY": "Y", "ITEM_TYPE": "DESC", "NOT_REQD_IN_XSD": "Y",
        "FLD_ANNOTATION": "Customer Name"},
       {"FIELD_NAME": "RISKCAT", "DATATYPE": "VARCHAR2", "MAX_LENGTH": "10", "REQUIRED": "Y",
        "DISPLAY_TYPE": "SELECT", "DEFAULT_VALUE": "LOW", "DBT": "STTMS_CUST_RISK_PROFILE",
        "DBC": "RISK_CATEGORY", "AMENDABLE_IN": "MODIFY", "FLD_ANNOTATION": "Risk Category",
        "custom_attrs": [
          {"ATTR_NAME": "LBL_LOW", "ATTR_VALUE": "LOW"},
          {"ATTR_NAME": "LBL_MEDIUM", "ATTR_VALUE": "MEDIUM"},
          {"ATTR_NAME": "LBL_HIGH", "ATTR_VALUE": "HIGH"}
        ]},
       {"FIELD_NAME": "REVIEWDT", "DATATYPE": "DATE", "MAX_LENGTH": "7", "REQUIRED": "Y", "DISPLAY_TYPE": "DATE",
        "DBT": "STTMS_CUST_RISK_PROFILE", "DBC": "REVIEW_DATE", "AMENDABLE_IN": "MODIFY",
        "FLD_ANNOTATION": "Review Date"},
       {"FIELD_NAME": "REMARKS", "FIELD_SIZE": "50", "DATATYPE": "VARCHAR2", "MAX_LENGTH": "255",
        "DISPLAY_TYPE": "TEXTAREA", "TXTAREA_ROWS": "3", "TXTAREA_COLS": "50", "DBT": "STTMS_CUST_RISK_PROFILE",
        "DBC": "REMARKS", "AMENDABLE_IN": "MODIFY", "FLD_ANNOTATION": "Remarks"}
     ]},
    {"BLOCK_NAME": "BLK_FACTOR_DETAILS", "BLOCK_PARENT": "BLK_RISK_MASTER", "MULTI_RECORD": "Y",
     "RELATION_TYPE": "N", "BLK_PK_FLD": "CUSTNO~FACTORCD", "BLOCK_TITLE": "LBL_RISK_FACTORS",
     "XSD_NODE": "Factor-Details", "NEW_ALLOWED_IN": "MODIFY", "DELETE_ALLOWED_IN": "MODIFY",
     "ALL_RECORDS": "MODIFY",
     "datasources": ["STTMS_CUST_RISK_FACTOR"],
     "fields": [
       {"FIELD_NAME": "CUSTNO", "BLOCK_PK_FLD": "Y", "FIELD_SIZE": "20", "DATATYPE": "VARCHAR2", "MAX_LENGTH": "20",
        "DBT": "STTMS_CUST_RISK_FACTOR", "DBC": "CUSTOMER_NO", "VISIBLE": "N", "NOT_REQD_IN_XSD": "Y",
        "FLD_ANNOTATION": "Customer No"},
       {"FIELD_NAME": "FACTORCD", "BLOCK_PK_FLD": "Y", "FIELD_SIZE": "10", "DATATYPE": "VARCHAR2",
        "MAX_LENGTH": "10", "REQUIRED": "Y", "DISPLAY_TYPE": "RESTRICTED_TEXT", "DBT": "STTMS_CUST_RISK_FACTOR",
        "DBC": "FACTOR_CODE", "CHK_UPPERCASE": "Y", "FLD_ANNOTATION": "Factor Code"},
       {"FIELD_NAME": "FACTSCORE", "FIELD_SIZE": "6", "DATATYPE": "NUMBER", "MAX_LENGTH": "22", "REQUIRED": "Y",
        "MIN_VAL": "0", "MAX_VAL": "100", "MAX_DECIMALS": "2", "DBT": "STTMS_CUST_RISK_FACTOR",
        "DBC": "FACTOR_SCORE", "AMENDABLE_IN": "MODIFY", "FLD_ANNOTATION": "Factor Score"}
     ]}
  ],

  "screens": [
    {"SCREEN_NAME": "CVS_MAIN", "SCREEN_TITLE": "LBL_CUST_RISK_PROFILE", "MAIN_SCREEN": "Y", "SCREEN_SIZE": "LARGE",
     "EXIT_BUTTON_TYPE": "1",
     "body_tabs": [
       {"TAB_NAME": "TAB_MAIN", "TAB_LABEL": "LBL_MAIN",
        "sections": [
          {"SECTION_NAME": "SEC_HEADER", "partitions": [["PART_1", 50], ["PART_2", 50]]},
          {"SECTION_NAME": "SEC_FACTORS", "partitions": [["PART_1", 100]]}
        ]}
     ]}
  ],

  "fieldsets": [
    {"FIELDSET_NAME": "FST_RISK_HDR", "FIELDSET_BLOCK": "BLK_RISK_MASTER", "FIELDSET_SCREEN": "CVS_MAIN",
     "FIELDSET_TAB": "TAB_MAIN", "FIELDSET_SECTION": "SEC_HEADER", "FIELDSET_PARTITION": "PART_1",
     "FIELDSET_LABEL": "LBL_RISK_PROFILE", "fields": ["CUSTNO", "CUSTNAME", "RISKCAT"]},
    {"FIELDSET_NAME": "FST_RISK_REVIEW", "FIELDSET_BLOCK": "BLK_RISK_MASTER", "FIELDSET_SCREEN": "CVS_MAIN",
     "FIELDSET_TAB": "TAB_MAIN", "FIELDSET_SECTION": "SEC_HEADER", "FIELDSET_PARTITION": "PART_2",
     "FIELDSET_LABEL": "LBL_REVIEW", "fields": ["REVIEWDT", "REMARKS"]},
    {"FIELDSET_NAME": "FST_FACTORS", "FIELDSET_BLOCK": "BLK_FACTOR_DETAILS", "FIELDSET_SCREEN": "CVS_MAIN",
     "FIELDSET_TAB": "TAB_MAIN", "FIELDSET_SECTION": "SEC_FACTORS", "FIELDSET_PARTITION": "PART_1",
     "VIEW_TYPE": "MULTIPLE", "MULTI_RECORD": "Y", "ROWS_PER_PAGE": "10", "FIELDSET_LABEL": "LBL_RISK_FACTORS",
     "fields": ["FACTORCD", "FACTSCORE", "CUSTNO"]}
