{
  "_comment": "Example spec for gen_radxml.py: Customer Risk Profile maintenance (master + 1:N child, LOV with description field, select list, date, text area, summary). Upper-case keys are ODT tag names and values; lower-case keys are structure.",
  "FUNCTION_ID": "STDCURSK",
  "FUNCTION_CATEGORY": "MAINTENANCE",
  "FOOTER_TEMPLATE": "MAINTAUDIT",
  "RELEASE_TYPE": "CUSTOM",
  "RELEASE_CODE": "FCUBS_14.7.0.6.0",
  "MODULE_ID": "ST",
  "MODULE_DESC": "Static Maintenance",
  "CONTROL_STRING": "1111111100000000",
  "preferences": {"LOGGING_REQD": "Y", "EXPORT_REQD": "Y"},
  "menu": [{"FUNCTION_ID": "STDCURSK"}, {"FUNCTION_ID": "STSCURSK"}],

  "datasources": [
    {"DATASRC_NAME": "STTMS_CUST_RISK_PROFILE", "MASTER_DATASRC": "Y", "RELATION_TYPE": "1",
     "PK_COLS": "CUSTOMER_NO", "PK_TYPES": "VARCHAR2"},
    {"DATASRC_NAME": "STTMS_CUST_RISK_FACTOR", "PARENT_DATASRC": "STTMS_CUST_RISK_PROFILE",
