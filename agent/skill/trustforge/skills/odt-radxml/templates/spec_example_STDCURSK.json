  "summary": {
    "TITLE": "LBL_CUST_RISK_SUMMARY", "RSLT_DATASRC": "STTMS_CUST_RISK_PROFILE", "RSLT_DATABLK": "BLK_RISK_MASTER",
    "RAD_SUMMARY_ORDERBY": "CUSTOMER_NO", "SUM_SCREEN_SIZE": "LARGE",
    "SUM_QUERYORDER": "CUSTNO~RISKCAT", "SUM_RESULTORDER": "CUSTNO~RISKCAT~REVIEWDT",
    "fields": [
      {"FIELD_NAME": "CUSTNO", "QUERY": "Y", "LOV_NAME": "LOV_CUSTOMER", "RETURN_FLDS": "CUSTNO~"},
      {"FIELD_NAME": "RISKCAT", "QUERY": "Y"},
      {"FIELD_NAME": "REVIEWDT", "QUERY": "N"}
    ]
  },

  "web_service": {}
}
