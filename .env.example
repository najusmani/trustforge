# Copy to .env.local for local runs, and set the same names in your hosting provider's settings.
# Never commit real values.

# Early-access sign-ups are emailed through Resend (https://resend.com).
RESEND_API_KEY=
# The inbox that receives sign-ups, for example sales@trustroutetechnologies.com
EARLY_ACCESS_TO=
# Sender on a domain you verified in Resend, for example "TrustForge <hello@trustroutetechnologies.com>"
EARLY_ACCESS_FROM=
