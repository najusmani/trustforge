# Copy to .env.local for local runs, and set the same names in your hosting provider's settings.
# Never commit real values.

# --- Sign-in (Auth.js) ---
# Random secret that signs sessions. Generate one with:  npx auth secret
AUTH_SECRET=
# Postgres connection string, e.g. from Neon (Vercel > Storage). Leave empty locally to use the
# embedded database in ./.data/pglite.
DATABASE_URL=
# Sender for sign-in links and team invites, on your Resend-verified domain.
# Falls back to EARLY_ACCESS_FROM when empty.
AUTH_EMAIL_FROM=

# --- TrustForge agents (Claude Managed Agents) ---
# Anthropic API key from console.anthropic.com (Settings > API Keys).
ANTHROPIC_API_KEY=
# Comma-separated emails that can open /admin (plans, agent setup).
ADMIN_EMAILS=

# --- Email (Resend, https://resend.com) ---
RESEND_API_KEY=

# --- Early-access sign-ups ---
# The inbox that receives sign-ups.
EARLY_ACCESS_TO=
# Sender on a domain you verified in Resend, for example "TrustForge <signups@trustroutetechnologies.com>"
EARLY_ACCESS_FROM=
